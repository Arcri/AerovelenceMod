		'''
		Non richiede munizioni
		Tasto destro per evocare un fulmine massiccio dal cielo
		'''
	SkillStrike: "[i:75] Il Fulmine esegue Colpi dell'Abilità su un colpo diretto [i:75]"
}

TheInfinity: {
