		'Ti mentirei mai?'
		I proiettili sparati rimbalzeranno
		'''
	SkillStrike: "[i:75] I proiettili rimbalzati possono o meno eseguire Colpi dell'Abilità [i:75]"
}

ShotgunAxe: {
	DisplayName: Ascia a Fucile
	Tooltip:
		'''
