AmuletOfGlory: {
	DisplayName: Amuleto della Gloria
	Tooltip:
		'''
		Colpire i nemici aumenta la velocità di movimento e di estrazione
		I nemici vicino ai bauli emetteranno luce
		'''
}

CrystalStompers: {
	DisplayName: Pestatori di Cristallo
	Tooltip: Tocca due volte in giù per eseguire un pestaggio di cristallo
}

OpalOfCaVea: {
	DisplayName: Opale di Ca Vea
	Tooltip:
		'''
		Cristalli luminosi crescono sulla tua schiena ogni 5 secondi, fino a 3
		I nemici subiscono danni se tutti e 3 i cristalli sono apparsi
		'''
}

PlatinumHook: {
	DisplayName: Gancio di Platino
	Tooltip: Estende tutti i ganci di gemme e li fa brillare
}

LargeGeode: {
	DisplayName: Grande Geode
	Tooltip:
		'''
		Non consumabile
		Evoca il Rullo di Cristallo
		Utilizzabile solo nell'Arena delle Caverne
		'''
}

ObsidianEye: {
	DisplayName: Occhio d'Ossidiana
	Tooltip:
		'''
		Non consumabile
		Evoca Cyvercry
		Utilizzabile solo di notte
		'''
}

OnTheRocks: {
	DisplayName: Sulle Rocce
	Tooltip: "'Età della Pietra'"
}

ResonanceDrill: {
	DisplayName: Trapano a Risonanza
	Tooltip: Estrae minerali connessi, più ne estrai, più è efficace
}

ElectricBlueSolution: {
	DisplayName: Soluzione Blu Elettrica
	Tooltip: Diffonde le Caverne di Cristallo
}

SpeedstersPickaxe: {
	DisplayName: Piccone del Velocista
	Tooltip: L'estrazione aumenta la velocità del tuo piccone
}

DeepFreeze: {
	DisplayName: Congelamento Profondo
	Tooltip: "'Fa freddo qui, o sono solo io?'"
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano sotto il 25% di mana [i:75]"
}

ElementalShift: {
	DisplayName: Cambio Elementale
	Tooltip:
		'''
		Attaccare crea una sfera di energia che può essere colpita
		Tasto destro per distruggere la sfera
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità avvengono dopo che la sfera rimbalza due volte su un nemico [i:75]"
}

Eos: {
	DisplayName: Eos
	Tooltip:
		'''
		Termina una combo con un attacco rotante
		Colpisci i nemici con la rotazione mentre scatti per rimbalzare, ottenendo una breve invulnerabilità
		Dopo il rimbalzo su un nemico, i tuoi prossimi 2 combo spareranno proiettili
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità avvengono dopo un rimbalzo [i:75]"
}

ExtinguishedDynamite: {
	DisplayName: Dinamite Spenta
	SkillStrike: "[i:75] Esplode ogni secondo ed esegue Colpi dell'Abilità [i:75]"
	Tooltip: ""
}

CrystalCrescent: {
	DisplayName: Crescente di Cristallo
	Tooltip: Lancia un bastone da combattimento che ritorna dopo un colpo rapido
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano mentre è in mano [i:75]"
}

NerveFlagellator: {
	DisplayName: Flagellatore Nervoso
	Tooltip:
		'''
		Attacca con più viticci nervosi
		I nemici marchiati possono evocare un rampicante nervoso amichevole quando colpiti
		'''
	SkillStrike: "[i:75] I piccoli viticci nervosi eseguono Colpi dell'Abilità [i:75]"
}

Solsear: {
	DisplayName: Scottasole
	Tooltip:
		'''
		Spara un laser continuo che infligge più danni alla punta
		Tasto destro per sparare una bomba
		Mira la punta del laser sulla bomba per aumentarne il danno e la dimensione
		'Con grande potenza di fuoco viene grande irresponsabilità'
		'''
	SkillStrike: "[i:75] Le Bombe eseguono Colpi dell'Abilità alla massima dimensione [i:75]"
}

FlareGun: {
	DisplayName: Pistola Razzo da Combattimento
	Tooltip:
		'''
		Non richiede munizioni
		5% di probabilità di critico per tag degli evocatori
		Clicca di nuovo con il giusto tempismo per sparare più velocemente
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano a lunga distanza [i:75]"
}

CerobaStaffItem: {
	DisplayName: Devozione
	Tooltip:
		'''
		Tasto destro per attaccare con un sigillo che marchia i nemici
		I nemici marchiati subiscono danni enormemente aumentati dall'arma
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano sui nemici marchiati [i:75]"
}

ClockworkLazinator: {
	DisplayName: Lazinator a Ingranaggi
	Tooltip:
		'''
		Tasto destro per caricare l'arma, aumentando la durata del fuoco
		Si ferma a 4 cariche
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano dopo aver sparato abbastanza a lungo [i:75]"
}

CrystalGlade: {
	DisplayName: Radura di Cristallo
	Tooltip: Tasto destro per evocare un portale che cambierà l'origine dei tuoi colpi
	SkillStrike: "[i:75] I colpi dal portale eseguono Colpi dell'Abilità [i:75]"
}

TheBeacon: {
	DisplayName: Il Faro
	Tooltip:
		'''
		Mira al nemico più vicino al cursore
		Rilascia viticci fiammeggianti attorno al nemico bersaglio
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano dopo aver puntato lo stesso nemico per un po' [i:75]"
}

TheFlashlight: {
	DisplayName: La Torcia
	Tooltip: Mira al nemico più vicino al cursore
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano dopo aver puntato lo stesso nemico per un po' [i:75]"
}

TheLaserPointer: {
	DisplayName: Puntatore Laser
	Tooltip:
		'''
		Mira al nemico più vicino al cursore
		Rilascia scintille a ricerca dopo aver puntato lo stesso nemico per un po'
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano dopo aver puntato lo stesso nemico per un po' [i:75]"
}

WandOfExploding: {
	DisplayName: Bacchetta delle Esplosioni
	Tooltip: Infligge Bruciatura di Mana, facendo perdere stelle ai nemici che ripristinano mana
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano sotto il 50% di mana [i:75]"
}

TetraBlades: {
	DisplayName: Lame Tetra
	Tooltip: Tasto destro per scattare fino a 4 volte
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano dopo aver usato tutti e 4 gli scatti [i:75]"
}

TheSahara: {
	DisplayName: Il Sahara
	Tooltip:
		'''
		Tieni premuto per caricare, aumentando danni e velocità
		Rilascia un vortice di fuoco alla carica completa
		'''
	SkillStrike: "[i:75] Il Vortice di Fuoco esegue Colpi dell'Abilità [i:75]"
}

WarBow: {
	DisplayName: Arco da Guerra
	Tooltip:
		'''
		Tieni premuto per caricare, aumentando danni e velocità
		Incorpora una punta nei nemici a carica completa
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano rilasciando con tempismo perfetto [i:75]"
}

GraniteCannon: {
	DisplayName: Cannone di Granito
	Tooltip:
		'''
		Converte i proiettili in pezzi di granito
		Se due pezzi si scontrano a mezz'aria, si rompono in nuclei energetici a ricerca
		'''
	SkillStrike: "[i:75] I Nuclei di Energia eseguono Colpi dell'Abilità [i:75]"
}

AdamantitePulsar: {
	DisplayName: Pulsar di Adamantite
