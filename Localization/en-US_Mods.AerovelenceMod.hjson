BurningJealousy: {
	DisplayName: Hell Brigade

	Tooltip: {
		$parentVal:
			'''
			Hold Right-Click to guard, gaining a large defense boost
			Retaliate with an explosive counter-attack if hit while guarding
			'''
		es:
			'''
			Mantén clic derecho para bloquear, obteniendo un gran impulso de defensa
			Contraataca explosivamente si te golpean mientras bloqueas
			'''
	}

	SkillStrike: {
		$parentVal: "[i:75] Counter-Attack Skill Strikes [i:75]"
