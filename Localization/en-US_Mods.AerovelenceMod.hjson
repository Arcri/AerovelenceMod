	Tooltip:
		'''
		'È più vicino di quanto pensi! (No, non lo è)'
		Tasto destro per cambiare elemento
		'''
	SkillStrike: "[i:75] I Colpi dell'Abilità si attivano sotto i 50 di difesa [i:75]"
}

MarbleMusket: {
	DisplayName: Moschetto di Marmo
	Tooltip:
		'''
		Converte i proiettili in speciali proiettili influenzati dalla gravità
		Colpisci 3 volte di fila per rilasciare stelle a ricerca
		'''
	SkillStrike: "[i:75] Le Stelle eseguono Colpi dell'Abilità [i:75]"
}

PouchOfRocks: {
