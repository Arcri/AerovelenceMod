		DisplayName: Cavern Sand Wall Item
		Tooltip: ""
	}

	BandOfCrystallization: {
		DisplayName: Band of Crystallization
		Tooltip:
			'''
			Grows 1 defense every 10 seconds in combat, up to 10
			Outside combat, grows 1 defense every 5 seconds, up to 20
			Entering combat sheds defense above 10; bosses keep you in combat
			Glowing crystals show your growing protection
			Removing the band sheds its crystals
			'''
	}

	PetrifiedShackles: {
		DisplayName: Petrified Shackles
		Tooltip:
			'''
			Grants 1 defense and reduces attack speed by 10%
			Grows 1 defense every 7 seconds in combat, up to 15
			Outside combat, grows 1 defense every 4 seconds, up to 25
			Entering combat sheds growth above 15; bosses keep you in combat
			Cannot be equipped with Band of Crystallization
			'''
	}

	SpikesInABottle: {
		DisplayName: Spikes in a Bottle
		Tooltip:
			'''
			Allows a Cloud-strength double jump that scatters crystal caltrops
			Taking at least 15% of maximum life in one hit scatters more after half a second
			The retaliation can occur once every 6 seconds
			Cannot be made into a balloon: it would pop
			'''
	}

	CrystalDrillrow: {
		DisplayName: Crystal Drillrow
		Tooltip:
			'''
			Drills through one continuous section of terrain, up to 12 tiles thick
			Emerges with an energized crystal tip that deals 15% more damage
			The worn drill breaks against the next wall
			'''
	}

	CrystalStoneSlug: {
		DisplayName: Crystal Stone Slug
		Tooltip:
			'''
			Embeds crystal splinters for 3 seconds on impact
			Well-timed throws deal 2x Skill Strike damage
			'''
	}

	StoneSlug: {
		DisplayName: Stone Slug
		Tooltip:
			'''
			A heavy sling stone with a steep, short-range arc
			Well-timed throws deal 2.25x Skill Strike damage
			'''
	}

	WoodSlug: {
		DisplayName: Wood Slug
		Tooltip:
			'''
			A light sling slug with a long, shallow arc
			Well-timed throws deal 1.5x Skill Strike damage
			'''
	}

	Minerall: {
		DisplayName: Minerall
		Tooltip:
			'''
			Increases mining speed by 15%, movement speed by 10%, and mining reach by 1
			Lasts 5 minutes and stacks with Mining Potion
			'''
	}

	MineralWater: {
		DisplayName: Mineral Water
		Tooltip:
			'''
			Restores 60 life with 30 seconds of potion sickness
			Grants 40 defense for 30 seconds, but inflicts mineral poisoning for 12 seconds
			Poisoning drains 10 life per second
			Contains enough sediment to cause stomach or throat stones. Worse than a kidney stone.
			'''
	}

	BabyCondurtleEgg: {
		DisplayName: Baby Condurtle Egg
		Tooltip:
			'''
			Hatches a Baby Condurtle town pet
			Permanently welcomes it to this world; it can share a home with a townsperson
			Occasionally laid by living Condurtles
			'''
	}

	GlimmerwoodHamaxe: {
		DisplayName: Glimmerwood Hamaxe
		Tooltip: ""
	}

	CrystalTumblerBag: {
		DisplayName: Treasure Bag (Crystal Tumbler)
		Tooltip:
			'''
			Right click to open
			Contains a Tumbler weapon and the Tumbling Harness
			'''
	}

	ConductorWand: {
		DisplayName: Conductor Wand
		Tooltip:
			'''
			Channel a tethered electric bubble that gathers your minions
			Three captured minions and an additional 50 mana unleash a single plasma shock
			Drains 2 mana plus 2 per captured summon every half second
			Release to free your summons; start a new bubble to shock again
			Alternatively carries one sentry; falling sentries release a landing shock
			'''
	}

	FenceSitter: {
		DisplayName: Fence Sitter
		Tooltip:
			'''
			Each swing strikes one enemy with a weighty stop
			Land four consecutive swings to unleash four lightning fences on the fifth
			Each fence stops at terrain and strikes each enemy twice
			Missing or changing weapons breaks the streak
			'''
	}

	Geomagnetic: {
		DisplayName: Geomagnetic
		Tooltip:
			'''
			Fires a crackling beam of geomagnetic lightning
			At or below 25% mana, casts a hovering sphere that releases three bolts
			The sphere electrifies enemies on contact
			'''
	}

	TumblerAccelerator: {
		DisplayName: Tumbler Accelerator
		Tooltip:
			'''
			Catapults tiny tumblers without ammunition
			Right click to suspend airborne tumblers, charge them, and launch them toward your cursor
			Paired impacts electrify enemies
			'''
	}

	BluntJavelin: {
		DisplayName: Blunt Javelin
		Tooltip: A heavy cavern-stone javelin that breaks apart on impact
	}

	CavernousRampart: {
		DisplayName: Cavernous Rampart
		Tooltip:
			'''
			Hold to guard toward the cursor; cannot be used while mounted
			Hits against the shield receive 12 additional defense
			A guarded hit exceeding 20% of maximum life shatters it for 6 seconds
			Fast movement bashes enemies and grants a brief moment of invulnerability
			'''
	}

	CavernsBrandistock: {
		DisplayName: Cavern's Brandistock
		Tooltip:
			'''
			Successful thrusts build blade stress
			At 40% stress, three hidden crystal blades extend and Skill Strike
			At maximum stress, the blades shatter and retract for 4 seconds
			You can still thrust in staff mode while the mechanism recovers
			Pause between attacks to let the stress fall
			'''
	}

	Faultbreaker: {
		DisplayName: Faultbreaker
		Tooltip: A weighty sledgehammer with a crushing overhead swing
	}

	GlimmerwoodBow: {
		DisplayName: Glimmerwood Bow
		Tooltip:
			'''
			Every third shot turns its arrow into a Crystal Drillrow
			Drillrows bore through one section of terrain
			'''
	}

	GlimmerwoodSword: {
		DisplayName: Glimmerwood Sword
		Tooltip: A simple wooden blade with a glimmer in its grain
	}

	PinCushionStone: {
		DisplayName: Pin-Cushion Stone
		Tooltip:
			'''
			First throw launches a floating pin-cushion stone
			Further throws fire darts that pierce one enemy
			Darts lodge in the stone and nudge it, empowering its next impacts
			Every third empowered collision rebounds much harder
			After 10 seconds without a dart, the stone dissolves and releases its pins
			'''
	}

	RockRumbler: {
		DisplayName: Rock Rumbler
		Tooltip:
			'''
			Shoulder-fpires rocky energy bombs that shatter in a crystal blast
			The white-hot launch burst marks the direct-hit Skill Strike window
			Bombs lose their thrust and drop heavily after the burst
			Does not consume ammo
			'''
	}

	Saphead: {
		DisplayName: Saphead
		Tooltip:
			'''
			Channel to spiral a living sapper head around you
			Move the cursor closer to tighten its orbit and spout crystal fog faster
			The stem glows and the flower swells before each puff
			Consumes 5 mana per puff; the initial cast pays for the first
			Release to coil the stem back into your hand
			'A severed sapper stem, improbably still alive'
			'''
	}

	SaplingCane: {
		DisplayName: Sap-ling Cane
		Tooltip:
			'''
			Plants three baby sappers using one sentry slot
			Hold right click to guide them in short hops and designate enemies
			They snap at nearby foes and return to their patch when left alone
			Bites against your designated summon target deal Skill Strikes
			'''
	}

	Shattershot: {
		DisplayName: Shattershot
		Tooltip:
			'''
			Blasts four heavy pieces of flint and gravel in a wide spread
			Consumes one stone block or cavern stone per blast
			Cavern stone fires glowing gravel and sometimes an extra white-hot crystal fragment
			'''
	}

	SpeleothemConjurer: {
		DisplayName: Speleothem Conjurer
		Tooltip:
			'''
			Channel a stationary shower of ethereal stalactites at the cursor
			Consumes 6 mana per spike; impacts leave crystal sediment
			Release to pull the sediment together and erupt a towering stalagmite
			Gather 12 impacts for a Skill Strike; the crystal shines white when ready
			'''
	}

	StackerRock: {
		DisplayName: Stacker Rock
		Tooltip:
			'''
			Rocks meant for stacking
			Thrown discs anchor to solid floors and can be stacked from above
			Each added rock extends the tower’s lifetime
			Hit a tower from the side to topple it early
			'''
	}

	TheSling: {
		DisplayName: The Sling
		Tooltip:
			'''
			Hold to wind up a slug in a moth-silk sling
			Release to throw in the direction the pouch is traveling
			Aim beyond the orbit; the white flash and chime mark a powerful, well-aligned throw
			Stone slugs hit hard, wood flies farther, and crystal leaves splinters
			Uses one slug per wind-up
			'''
	}

	TumblerCommander: {
		DisplayName: Tumbler Commander
		Tooltip:
			'''
			Channel to guide a tiny tumbler along floors and walls toward the cursor
			More distant targets make it roll faster
			Consumes 4 mana each half-second
			'''
	}

	TrojanForce: {
		DisplayName: Trojan Force
		Tooltip: ""
	}

