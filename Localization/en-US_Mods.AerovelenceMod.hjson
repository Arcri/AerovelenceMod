	BurningJealousy: {
		DisplayName: Hell Brigade
		Tooltip:
			'''
			Hold Right-Click to guard, gaining a large defense boost
			Retaliate with an explosive counter-attack if hit while guarding
			'''
	}

	Solsear: {
		DisplayName: Solsear
		Tooltip:
			'''
			Fires a continuous laser that deals more damage at the tip
			Right-Click to fire a bomb
			Aim the tip of the laser into the bomb to increase its damage and size
			'With great firepower comes great irresponsibility'
			'''
	}

	FlareGun: {
		DisplayName: Combat Flare Gun
		Tooltip:
			'''
			Does not require ammo
			5% summon tag crit chance
			Click again with good timing to fire faster
			'''
	}

	DeepFreeze: {
		DisplayName: Deep Freeze
