	SilkenScarf: {
		Tooltip:
			'''
			Slightly reduces enemy aggression
			Restores 1 mana each second for each summoned minion
			An ancient scarf of crystal moth silk, interlaced with crystal fibers
			The moths refuse to eat it. Apart from the dust, it looks perfectly fine!
			'''
		DisplayName: Silken Scarf
	}

	BuildersPermit: {
		DisplayName: Builder's Permit
		Tooltip:
			'''
			+50% building and placement speed
			+1 max sentry
			'''
	}

	PileOfContracts: {
		DisplayName: Pile of Contracts
		Tooltip:
			'''
			+4% summon damage
			Your minions are contractually obligated to crit
			Minion critical strikes now deal 5% more than base damage
			'''
	}

	RepurposedWinch: {
		DisplayName: Repurposed Winch
		Tooltip:
			'''
			Whips can no longer autoswing
			Hold use to wind up, then release to attack
			Quick attacks have slightly reduced range
			Charging increases whip range and damage, up to 35% range and 50% damage
			'''
	}

	CrystallineDynamite: {
		DisplayName: Crystalline Dynamite
		Tooltip:
			'''
			A reusable stick of dynamite
			The blast scatters crystal fragments that remagnetize toward you
			Reforms 30 seconds after being thrown
			'''
	}

	MimikosMirror: {
		DisplayName: Mimiko's Mirror
		Tooltip:
			'''
			Reflects magical light to banish evil
			Hold to scatter five rays of demonite light
			The rays periodically align, flash three times, then scatter again
			Consumes 10 mana per second while channeling
			'''
	}

